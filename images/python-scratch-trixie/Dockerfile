# syntax=docker/dockerfile:1.7
#
# Two-stage build. Builder on python:3.14-slim-trixie (same base as the
# scratch baseline so glibc versions line up). Runtime FROM scratch, with
# the shared foundation (glibc + TLS + DNS + zoneinfo + /etc) coming from
# scratch-base-trixie and Python-specific closure COPY'd from the builder.
#
# No shell, no apt, no dpkg database. Pip bundled so `pip install --target`
# works for wheel-only packages at runtime.

ARG SCRATCH_BASE_REF=ghcr.io/bboortz/scratch-base-trixie:latest
# FG-025 Phase 2: builder stage FROMs the shared forge-builder-trixie image
# (apt-upgraded + CA certs + syft pre-installed). Local build overrides this
# to forge-local/forge-builder-trixie:0.1 via scripts/build-image.sh.
ARG FORGE_BUILDER_REF=ghcr.io/bboortz/forge-builder-trixie:latest
# FG-031: embed `hc` (static Zig healthcheck binary from bboortz/healthy) so
# consumer apps can wire a docker HEALTHCHECK at their own path/port without
# a sidecar. We do NOT bake HEALTHCHECK here — consumer apps vary too much
# in port + path for a safe default. Same pin as FG-030.
ARG HC_REF=ghcr.io/bboortz/hc:0.1.0
# FG-032: Python major version hoisted to a single ARG so future bumps
# (3.14 → 3.15 → …) are a one-line change. Called PY_VERSION (not
# PYTHON_VERSION) because Docker Hub's python base image sets
# `ENV PYTHON_VERSION=3.14.10`, and ENV wins over ARG in RUN shell
# expansion — our ARG would be clobbered.
# forge-builder-trixie independently tracks `python:3.14-slim-trixie`
# as its DEBIAN_BASE; the two must move together.
ARG PY_VERSION=3.14

# --- Stage 0: baseline reference ---------------------------------------------
FROM ${SCRATCH_BASE_REF} AS scratch_base

# --- Stage 0b: hc binary source (FG-031) -------------------------------------
FROM ${HC_REF} AS hc

# --- Stage 1: builder ---------------------------------------------------------
FROM ${FORGE_BUILDER_REF} AS builder

# Re-declare ARG inside the stage so the RUN steps below can expand it
# (Docker ARG scoping: pre-FROM ARGs are only visible in FROM lines).
ARG PY_VERSION
ARG GIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown

# apt lists are empty per forge-builder-trixie's PROMISES.apt.no-cache —
# re-populate, then apply image-specific sid-pins before anything else.
COPY sid-pins/ /etc/apt/preferences.d/

# FG-033: compile C.UTF-8 + en_US.UTF-8 locales so `ENV LANG=C.UTF-8`
# (set in the runtime stage) is actually honored. glibc's setlocale
# falls back to the C locale without these files on disk. Using
# localedef (not locale-gen) so we get exactly these two locales —
# a bare locale-gen would bloat the archive by ~55 MB.
#
# locales package is apt-installed just for the compile; purged
# immediately after so the SBOM doesn't falsely list it as a runtime
# component (only /usr/lib/locale/*.utf8/ artifacts ship — those are
# generated by localedef and not dpkg-tracked).
# hadolint ignore=DL3008,DL4006
RUN set -eux; \
    apt-get update; \
    apt-get -y --no-install-recommends install locales; \
    localedef --no-archive -c -i C     -f UTF-8 C.UTF-8; \
    localedef --no-archive -c -i en_US -f UTF-8 en_US.UTF-8; \
    test -f /usr/lib/locale/C.utf8/LC_CTYPE; \
    test -f /usr/lib/locale/en_US.utf8/LC_CTYPE; \
    locale -a | grep -qx C.utf8; \
    locale -a | grep -qx en_US.utf8; \
    apt-get -y purge locales; \
    apt-get -y --purge autoremove; \
    rm -rf /var/lib/apt/lists/*

# FG-020: embedded SBOM from builder-stage dpkg. syft is pre-installed by
# forge-builder-trixie (FG-025). We don't re-apt-upgrade — that's pre-done.
# Runs AFTER the FG-033 locale compile so the apt-install blip for `locales`
# is purged before the catalog is taken (the generated /usr/lib/locale/*.utf8
# files are the overlay artifact; the package isn't in runtime).
RUN set -eux; \
    syft dir:/ --override-default-catalogers dpkg-db-cataloger -o cyclonedx-json > /sbom.json

# Collect the Python-specific overlay. Baseline already supplies glibc + TLS
# + DNS + zoneinfo + minimal /etc (including /etc/passwd + /etc/group with
# root+nobody, which Python doesn't need to augment — no service user).
# We only COPY the Python interpreter, stdlib, libpython, pip, and Python's
# own stdlib C-extension deps (sqlite, bz2, lzma, zstd, expat, ffi, nsl,
# tirpc) + libutil (openpty/forkpty stdlib dep, not in baseline).
RUN set -eux; \
    install -d /out/usr/local/bin /out/usr/local/lib \
               /out/lib/x86_64-linux-gnu \
               /out/usr/lib/locale; \
    # FG-033: ship both compiled UTF-8 locales + the locale archive so
    # `ENV LANG=C.UTF-8` is actually honored and `locale.setlocale(...)`
    # succeeds for both C.UTF-8 and en_US.UTF-8.
    cp -r /usr/lib/locale/C.utf8     /out/usr/lib/locale/C.utf8; \
    cp -r /usr/lib/locale/en_US.utf8 /out/usr/lib/locale/en_US.utf8; \
    cp /usr/lib/locale/locale-archive /out/usr/lib/locale/locale-archive 2>/dev/null || true; \
    # Interpreter + stdlib + libpython + python3/python symlinks.
    cp -a "/usr/local/bin/python${PY_VERSION}"  "/out/usr/local/bin/python${PY_VERSION}"; \
    cp -a /usr/local/bin/python3     /out/usr/local/bin/python3     2>/dev/null || ln -s "python${PY_VERSION}" /out/usr/local/bin/python3; \
    cp -a /usr/local/bin/python      /out/usr/local/bin/python      2>/dev/null || ln -s python3   /out/usr/local/bin/python; \
    cp -r "/usr/local/lib/python${PY_VERSION}"  "/out/usr/local/lib/python${PY_VERSION}"; \
    cp -a /usr/local/lib/libpython3*.so* /out/usr/local/lib/; \
    # Python-specific stdlib C-extension dyn deps (baseline supplies the core
    # but NOT libutil; the pty/openpty stdlib module needs it).
    #
    # librt.so.1: glibc 2.34 merged librt into libc; Debian trixie ships an
    # empty 14.5 KB stub for binaries still carrying NEEDED librt.so.1. All
    # manylinux2014 / manylinux_2_17 wheels (numpy, scipy, pandas, pillow,
    # cryptography, …) are built against glibc 2.17 and need the stub to
    # dlopen. FG-011: ship it so `pip install <popular-wheel>` doesn't
    # silently break in scratch.
    for lib in libutil.so.1 librt.so.1 \
               libbz2.so.1.0 liblzma.so.5 libzstd.so.1 \
               libexpat.so.1 libffi.so.8 libsqlite3.so.0 \
               libnsl.so.2 libtirpc.so.3; do \
      cp "/lib/x86_64-linux-gnu/$lib" "/out/lib/x86_64-linux-gnu/$lib" 2>/dev/null || true; \
    done; \
    # pip binary + symlinks.
    cp -a /usr/local/bin/pip* /out/usr/local/bin/ 2>/dev/null || true; \
    # Strip bytecode caches + unused stdlib trees.
    find "/out/usr/local/lib/python${PY_VERSION}" -type d -name __pycache__ -exec rm -rf {} + || true; \
    find "/out/usr/local/lib/python${PY_VERSION}" -name '*.pyc' -delete || true; \
    rm -rf "/out/usr/local/lib/python${PY_VERSION}/test" "/out/usr/local/lib/python${PY_VERSION}/idlelib" || true

# --- Stage 2: runtime (scratch) -----------------------------------------------
FROM scratch AS runtime

ARG GIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown

LABEL org.opencontainers.image.source="https://github.com/bboortz/forge"
LABEL org.opencontainers.image.licenses="Apache-2.0"
LABEL org.opencontainers.image.description="Minimal, continuously patched Python 3.14 base image (FROM scratch runtime, derives from scratch-base-trixie)"
LABEL org.opencontainers.image.revision="${GIT_SHA}"
LABEL org.opencontainers.image.created="${BUILD_TIMESTAMP}"

# Baseline first — glibc, TLS, DNS, zoneinfo, /etc/{passwd,group,nsswitch.conf,ssl/certs}.
# DL3067 silenced: copying the entire baseline is the whole point of the
# FG-005 composition pattern. Baseline is a signed audit-friendly artifact.
# hadolint ignore=DL3067
COPY --from=scratch_base / /
# Python-specific overlay. Later COPYs win if paths collide.
COPY --from=builder /out /
# FG-020: SBOM from the builder stage (with real Debian version suffixes).
# scan-regression.py extracts this and uses `grype sbom:<path>` so Debian
# backports are honored.
COPY --from=builder /sbom.json /sbom.json
# FG-031: healthcheck binary (static Zig, ~400 KB). Consumer apps wire a
# docker HEALTHCHECK against their own listener, e.g.:
#   HEALTHCHECK CMD ["/hc", "-t", "5", "http://127.0.0.1:8000/healthz"]
COPY --from=hc /hc /hc

# FG-009: baseline's ENV SSL_CERT_FILE does NOT propagate through COPY —
# we must re-declare here or every TLS call (urllib, requests, pip install,
# grype DB download, Telegram API) fails with CERTIFICATE_VERIFY_FAILED.
# See memory/scratch-closures.md § "ENV doesn't propagate" and
# docs/baseline-contract.md § "TLS trust".
ENV PATH=/usr/local/bin \
    LANG=C.UTF-8 \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    SSL_CERT_DIR=/etc/ssl/certs \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONFAULTHANDLER=1

# FG-009: run as nonroot (uid 65532, distroless convention, provided by
# scratch-base-trixie:0.2). Consumers who need root add `USER root`
# explicitly. HOME is baseline's /nonroot (owned 65532:65532).
WORKDIR /nonroot
USER 65532:65532

# FG-009: ENTRYPOINT = python3 (not CMD) so `docker run <image> script.py`
# works out of the box. Consumers override with --entrypoint for pip etc.
# `docker run <image>` (no args) drops into the REPL.
ENTRYPOINT ["/usr/local/bin/python3"]
CMD []
