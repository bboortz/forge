# syntax=docker/dockerfile:1.7
#
# FG-030: healthy-scratch-trixie v2 — hc-based minimal scratch sidecar.
#
# Composition:
#   - raw FROM scratch (zero inheritance)
#   - /hc — static Zig healthcheck binary from ghcr.io/bboortz/hc (no
#     libc, no heap, ~400 KB). Also provides `hc idle` keepalive mode
#     (HC-006) so we don't need coreutils sleep + libc + ld-linux.
#   - /sbom.json — generated by syft against the hc binary (FG-020)
#
# Result: ~500 KB image. Smaller than busybox:latest (~4.2 MB) by ~8×.

ARG HC_REF=ghcr.io/bboortz/hc:0.1.0
ARG FORGE_BUILDER_REF=ghcr.io/bboortz/forge-builder-trixie:latest

# --- Stage 0: hc binary source -----------------------------------------------
FROM ${HC_REF} AS hc

# --- Stage 1: SBOM builder (syft against the hc binary) ----------------------
FROM ${FORGE_BUILDER_REF} AS builder

ARG GIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown

COPY --from=hc /hc /tmp/hc
# syft is pre-installed in forge-builder-trixie (FG-025). Scan the hc
# binary directly — produces a minimal CycloneDX SBOM with the hc
# component. No OS-package footprint because hc is static Zig.
RUN set -eux; \
    syft file:/tmp/hc -o cyclonedx-json > /sbom.json

# --- Stage 2: runtime (raw scratch) ------------------------------------------
FROM scratch AS runtime

ARG GIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown

LABEL org.opencontainers.image.source="https://github.com/bboortz/forge"
LABEL org.opencontainers.image.licenses="Apache-2.0"
LABEL org.opencontainers.image.description="Minimal signed scratch sidecar carrying hc for healthcheck-companion deployments (~500 KB; hc idle keeps PID 1 alive)"
LABEL org.opencontainers.image.revision="${GIT_SHA}"
LABEL org.opencontainers.image.created="${BUILD_TIMESTAMP}"

COPY --from=hc /hc /hc
COPY --from=builder /sbom.json /sbom.json

# USER 65532 for distroless nonroot parity. /etc/passwd doesn't exist in
# raw scratch and hc doesn't do uid→name lookups, so a bare numeric uid
# is sufficient. Docker's healthcheck exec runs as this uid too.
USER 65532:65532
WORKDIR /
# CMD = `hc idle` — blocks on SIGTERM/SIGINT with ~0 CPU (HC-006).
# Docker's healthcheck invokes /hc <url> via the shared netns.
CMD ["/hc", "idle"]
