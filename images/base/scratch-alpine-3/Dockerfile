# syntax=docker/dockerfile:1.7
#
# FG-080: base/scratch-alpine-3 — musl scratch overlay. Parallel to
# base/scratch-trixie but for Alpine/musl instead of Debian/glibc.
#
# Closure (strict intersection of what Alpine-musl scratch consumers need):
#   - musl dynamic loader + libc
#   - TLS trust (ca-certificates bundle)
#   - name resolution stubs (/etc/nsswitch.conf, hosts, resolv.conf placeholder)
#   - minimal /etc identity (root + nobody + 65532 for nonroot baseline)
#   - /usr/share/zoneinfo/UTC (minimal zone)
#
# Language- or app-specific closures stay in the derivative (nginx libs,
# openssl, pcre, etc.).
#
# Derivatives consume it via an ARG pointing at this image + FROM that
# ARG + COPY --from=... / / overlay. See nginx-scratch-alpine for the
# canonical consumer shape. (ARG name intentionally not spelled out in
# this comment to avoid build-image.sh's grep heuristic triggering an
# infinite recursion when auto-resolving this image's own deps.)

ARG BASE_ALPINE_REF=ghcr.io/bboortz/base/alpine-3:3

# --- Stage 1: builder (stage curated closure into /out) ---------------------
# hadolint ignore=DL3002
FROM ${BASE_ALPINE_REF} AS builder
USER 0

ARG GIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown

# apk-install the packages we extract. base/alpine-3 already has
# ca-certificates installed via its pre-builder; musl is always present
# on Alpine (it IS the libc). We install tzdata to get UTC zone data.
# hadolint ignore=DL3018
RUN apk add --no-cache tzdata

# Stage layout into /out, preserving symlinks (-a) for the musl loader.
RUN set -eux; \
    mkdir -p /out/lib /out/etc/ssl/certs /out/usr/share/zoneinfo /out/tmp; \
    # musl loader + libc. On Alpine x86_64:
    #   /lib/ld-musl-x86_64.so.1 is a symlink → /lib/libc.musl-x86_64.so.1
    cp -a /lib/ld-musl-x86_64.so.1 /out/lib/ld-musl-x86_64.so.1; \
    cp -a /lib/libc.musl-x86_64.so.1 /out/lib/libc.musl-x86_64.so.1; \
    # TLS bundle (already generated by ca-certificates in base/alpine-3)
    cp /etc/ssl/certs/ca-certificates.crt /out/etc/ssl/certs/ca-certificates.crt; \
    # UTC zone (minimal tzdata footprint)
    cp /usr/share/zoneinfo/UTC /out/usr/share/zoneinfo/UTC; \
    # /tmp writable
    chmod 1777 /out/tmp

# Minimal /etc identity + name-resolution stubs. Alpine doesn't ship
# an /etc/nsswitch.conf by default (musl handles it internally), but
# we write one anyway so downstream apps that DO check it find a
# sensible policy.
# hadolint ignore=DL3059
RUN set -eux; \
    printf 'root:x:0:0:root:/root:/dev/null\nnobody:x:65534:65534:nobody:/:/dev/null\nnonroot:x:65532:65532:nonroot:/nonroot:/dev/null\n' > /out/etc/passwd; \
    printf 'root:x:0:\nnogroup:x:65534:\nnonroot:x:65532:\n' > /out/etc/group; \
    printf '127.0.0.1\tlocalhost\n::1\tlocalhost\n' > /out/etc/hosts; \
    printf 'hosts: files dns\n' > /out/etc/nsswitch.conf; \
    : > /out/etc/resolv.conf

# --- Stage 2: runtime (scratch) -----------------------------------------------
FROM scratch AS runtime

ARG GIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown

LABEL org.opencontainers.image.source="https://github.com/bboortz/forge"
LABEL org.opencontainers.image.licenses="Apache-2.0"
LABEL org.opencontainers.image.description="Scratch-musl runtime overlay (FG-080) — musl loader + libc + CA bundle + nss stubs + /etc identity + UTC zone. Consumed via COPY --from= by every Forge scratch-Alpine runtime (parallel to base/scratch-trixie for glibc)."
LABEL org.opencontainers.image.revision="${GIT_SHA}"
LABEL org.opencontainers.image.created="${BUILD_TIMESTAMP}"

COPY --from=builder /out /

USER 65532
